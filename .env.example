# ============================================================
# UPSM Baheratail - Environment Configuration
# ============================================================

# ========== Firebase Configuration ==========
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

FIREBASE_ADMIN_KEY=your-firebase-admin-sdk-key-json

# ========== Supabase Configuration ==========
# Connection for Citizen Registry, Tax Records, Certificate History, Audit Logs
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-side credentials (NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres

# ========== PostgreSQL Direct Connection (if using direct access) ==========
POSTGRES_URL=postgresql://user:password@host:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=upsm_baheratail

# ========== API Configuration ==========
VITE_API_BASE_URL=http://localhost:5000/api
API_PORT=5000
NODE_ENV=development

# ========== Gemini AI Configuration ==========
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ========== N8N Configuration ==========
N8N_WEBHOOK_URL=https://n8n.example.com/webhook
N8N_API_URL=https://n8n.example.com/api
N8N_API_KEY=your-n8n-api-key

# ========== Make (Zapier Alternative) Configuration ==========
MAKE_WEBHOOK_URL=https://hooks.make.com/handshakes/your-id
MAKE_API_KEY=your-make-api-key

# ========== Security & Authentication ==========
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=24h

# API Keys for external services
API_KEY_N8N=your-api-key
API_KEY_MAKE=your-api-key
API_KEY_GEMINI=your-api-key

# ========== Deployment & Hosting ==========
VERCEL_PROJECT_NAME=upsm-baheratail
VERCEL_TOKEN=your-vercel-token
DEPLOY_BRANCH=main

# ========== Logging & Monitoring ==========
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
MONITORING_ENABLED=true

# ========== Feature Flags ==========
ENABLE_AI_ASSISTANCE=true
ENABLE_LOCAL_AI=false
ENABLE_PRIVATE_AI_SERVER=false
ENABLE_SUPABASE_RLS=true
ENABLE_FIREBASE_SECURITY_RULES=true
