rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Certificates collection - readable for QR verification and searchable by memoNo/NID, manageable by all app users
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Configs collection - readable and editable by app users
    match /configs/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
