rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & RBAC via the `admins` collection
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isRegisteredAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.replace('[^a-zA-Z0-9]', '_')))
      );
    }

    function getAdminData() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
        ? get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data
        : get(/databases/$(database)/documents/admins/$(request.auth.token.email.replace('[^a-zA-Z0-9]', '_'))).data;
    }

    function isActiveAdmin() {
      return isRegisteredAdmin() && getAdminData().status != 'suspended';
    }

    function hasRole(role) {
      return isActiveAdmin() && getAdminData().role == role;
    }

    function isAdmin() {
      return isActiveAdmin() && (getAdminData().role == 'super_admin' || getAdminData().role == 'developer');
    }

    function isEditor() {
      return isActiveAdmin() && (getAdminData().role == 'chairman' || getAdminData().role == 'secretary' || isAdmin());
    }

    function isStaff() {
      return isActiveAdmin() && (getAdminData().role == 'member' || isEditor());
    }

    // -------------------- certificates collection --------------------
    match /certificates/{docId} {
      // Single certificate lookup / get for QR verification (Public access)
      allow get: if true;
      // List all certificate records for authenticated staff
      allow list: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // -------------------- configs collection --------------------
    match /configs/{configId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /configs/public/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /configs/secrets/{docId} {
      allow read, write: if isAdmin();
    }

    // -------------------- admins collection --------------------
    match /admins/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // -------------------- audit_logs collection --------------------
    match /audit_logs/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // -------------------- apiKeys collection --------------------
    match /apiKeys/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // -------------------- webhooks collection --------------------
    match /webhooks/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // -------------------- backups collection --------------------
    match /backups/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
